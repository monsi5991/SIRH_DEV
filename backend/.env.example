NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://sirh:sirh@localhost:5432/sirh_dev?schema=public

KEYCLOAK_ISSUER=http://localhost:8080/realms/SIRH-dev
KEYCLOAK_CLIENT_ID=sirh-frontend
KEYCLOAK_ALLOW_ACCOUNT_AUD=false

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Upload hardening
UPLOADS_PUBLIC=true
MAX_UPLOAD_SIZE_MB=10

# Basic API rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1200

# Notifications (optional webhooks)
NOTIFICATIONS_DELIVERY_MODE=log
NOTIFICATIONS_EMAIL_WEBHOOK_URL=
NOTIFICATIONS_WHATSAPP_WEBHOOK_URL=
NOTIFICATIONS_WEBHOOK_TOKEN=

# Safety for demo seed
ALLOW_DESTRUCTIVE_SEED=true
