{
  "name": "rbac-demo-backend",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "env:check": "node scripts/env-check.mjs",
    "env:check:preprod": "node scripts/env-check.mjs --env=preprod --file=.env.preprod --fallback=.env.preprod.example",
    "env:check:prod": "node scripts/env-check.mjs --env=prod --file=.env.production --fallback=.env.production.example",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "prisma:seed:demo": "node prisma/seed.js",
    "prisma:seed:reference": "node prisma/seed.reference.js",
    "rbac:sync-demo": "node scripts/sync-demo-rbac.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jose": "^6.1.3",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.17.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^5.22.0"
  }
}
