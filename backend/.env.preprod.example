NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://sirh_preprod_user:CHANGE_ME@preprod-db-host:5432/sirh_preprod?schema=public

KEYCLOAK_ISSUER=https://auth-preprod.example.com/realms/SIRH-preprod
KEYCLOAK_CLIENT_ID=sirh-frontend-preprod
KEYCLOAK_ALLOW_ACCOUNT_AUD=false

CORS_ALLOWED_ORIGINS=https://preprod.sirh.example.com

# Security posture: private uploads only
UPLOADS_PUBLIC=false
MAX_UPLOAD_SIZE_MB=10

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=800

NOTIFICATIONS_DELIVERY_MODE=webhook
NOTIFICATIONS_EMAIL_WEBHOOK_URL=https://preprod-hooks.example.com/email
NOTIFICATIONS_WHATSAPP_WEBHOOK_URL=https://preprod-hooks.example.com/whatsapp
NOTIFICATIONS_WEBHOOK_TOKEN=CHANGE_ME

# Must remain false outside dev
ALLOW_DESTRUCTIVE_SEED=false
