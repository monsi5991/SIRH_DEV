NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://sirh_prod_user:CHANGE_ME@prod-db-host:5432/sirh_prod?schema=public

KEYCLOAK_ISSUER=https://auth.example.com/realms/SIRH-prod
KEYCLOAK_CLIENT_ID=sirh-frontend-prod
KEYCLOAK_ALLOW_ACCOUNT_AUD=false

CORS_ALLOWED_ORIGINS=https://sirh.example.com

# Security posture: private uploads only
UPLOADS_PUBLIC=false
MAX_UPLOAD_SIZE_MB=10

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

NOTIFICATIONS_DELIVERY_MODE=webhook
NOTIFICATIONS_EMAIL_WEBHOOK_URL=https://hooks.example.com/email
NOTIFICATIONS_WHATSAPP_WEBHOOK_URL=https://hooks.example.com/whatsapp
NOTIFICATIONS_WEBHOOK_TOKEN=CHANGE_ME

# Must remain false outside dev
ALLOW_DESTRUCTIVE_SEED=false
